{
    "manifest_version": 3,
    "name": "Shimmer Tab for Helium",
    "short_name": "Shimmer Tab",
    "version": "1.0.0",
    "description": "Helium-styled new tab page built with Helium Prism components",
    "chrome_url_overrides": {
        "newtab": "index.html"
    },
    "permissions": [
        "storage",
        "search",
        "favicon",
        "topSites"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "icons": {
        "16": "icon-16.png",
        "32": "icon-32.png",
        "48": "icon-48.png",
        "128": "icon-128.png"
    }
}
